// The syntax table, shared by TestSyntax.cpp (expected results written by hand) and CompareSyntax.cpp (std::regex).
// RX_CASE(pattern, options, text, matches, contains, found, whole):
//   pattern   a raw string literal of the pattern
//   options   empty, or a chain such as .IgnoreCase()
//   text      the input
//   matches   1 when the whole text matches (Matches)
//   contains  1 when some part matches (Contains)
//   found     1 when Find finds a match from offset 0
//   whole     the text of the leftmost-first match (group 0), when found is 1
// Each includer defines RX_CASE before it includes this file.

RX_CASE("", , "", 1, 1, 1, "")
RX_CASE("", , "a", 0, 1, 1, "")
RX_CASE("a", , "a", 1, 1, 1, "a")
