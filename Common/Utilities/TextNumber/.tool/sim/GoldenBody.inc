// Golden cases shared by TestFormat.cpp (the TextNumber library) and TestPrintJsonGolden.cpp (Print and JSON). The expected texts
// and values were captured from Print and JSON before they moved onto the library, so both files must pass with the same list.
// Including file defines the macros used below before it includes this file, inside a function.
//
// GOLD_INT(type, value, base, text)            Print::NumberToString / FormatInteger, base as 2, 8, 10 or 16
// GOLD_FLOAT(value, precision, text)           Print::FloatToString / FormatFloat
// GOLD_JSON(value, precision, text)            JSON::Writer::Number(double) / FormatFixedPoint; "" means the value is refused
// GOLD_PARSE_INT(type, text, ok, value)        Print::StringToNumber / ParseInteger with '+' and leading blanks allowed
// GOLD_PARSE_FLOAT(text, ok, value)            Print::StringToFloat / ParseFloat with '+' and leading blanks allowed

